{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "color": {
            "1": "bright_white",
            "2": "white"
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "bright_white",
                "at": "bright_black",
                "host": "white"
            }
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "bright_white",
            "outputColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "keyColor": "bright_white",
            "outputColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "  Uptime",
            "keyColor": "bright_white",
            "outputColor": "cyan"
        },
        {
            "type": "packages",
            "key": "  Packages",
            "keyColor": "bright_white",
            "outputColor": "cyan"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "bright_white",
            "outputColor": "cyan"
        },
        {
            "type": "wm",
            "key": "  WM",
            "keyColor": "bright_white",
            "outputColor": "cyan"
        },
        {
            "type": "wmtheme",
            "key": "  Theme",
            "keyColor": "bright_white",
            "outputColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "  Terminal",
            "keyColor": "bright_white",
            "outputColor": "cyan"
        },
        "break",
        {
            "type": "cpu",
            "key": "  CPU",
            "keyColor": "white",
            "outputColor": "bright_cyan"
        },
        {
            "type": "gpu",
            "key": "  GPU",
            "keyColor": "white",
            "outputColor": "bright_cyan"
        },
        {
            "type": "memory",
            "key": "  Memory",
            "keyColor": "white",
            "outputColor": "bright_cyan"
        },
        {
            "type": "disk",
            "key": "  Disk",
            "keyColor": "white",
            "outputColor": "bright_cyan",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "  Battery",
            "keyColor": "white",
            "outputColor": "bright_cyan"
        },
        {
            "type": "display",
            "key": "  Display",
            "keyColor": "white",
            "outputColor": "bright_cyan"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "block"
        }
    ]
}
